build/
build-*/
out/
_deps/
compile_commands.json
.cache/
.vs/
.vscode/
.idea/
*.o
*.obj
*.exe
*.pdb
*.ilk
*.dSYM/
.DS_Store
tools/__pycache__/
__pycache__/

# Capture output from --shot and the CI smoke test.
*.bmp
!assets/*.bmp

# Tracks somebody makes while playing about are theirs, not the project's - the
# ones gearstick ships are content, and are committed.
*.gstrack
!assets/tracks/*.gstrack

# Recorded races. A replay worth keeping is one attached to a bug report or
# checked in as a golden test, not one left lying in the tree.
*.gsreplay
!tests/golden/*.gsreplay

# Dear ImGui writes this if the editor ever asks it to persist a layout. It
# does not today - see io->IniFilename in the frontend - but a stray one from a
# local experiment should not be committed.
imgui.ini

# Databases a test or a local server left behind, and SQLite's journal files
# beside them. The one database that *is* committed is the library a server
# ships with, which is built by gearstick_make_store and lives in assets/.
*.db
*.db-wal
*.db-shm
!assets/server/*.db
